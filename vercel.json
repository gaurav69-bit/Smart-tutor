{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "integration/week-4-browser-check": false
    }
  },
  "installCommand": "npm ci && npm ci --prefix apps/api",
  "buildCommand": "VITE_API_MODE=live npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "apps/api/migrations/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__route=:path*" }
  ]
}
