{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm ci --prefix apps/api",
  "buildCommand": "node apps/api/scripts/release-check.js && VITE_API_MODE=live npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "apps/api/migrations/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__route=:path*"
    }
  ],
  "regions": [
    "hnd1"
  ],
  "git": {
    "deploymentEnabled": {
      "fix/ST-23-account-review": false
    }
  }
}
