# Copy to apps/api/.env; .env must never be committed.
PORT=3001

# Default legacy SQLite:
DB_CLIENT=sqlite3
DATABASE_FILE=./data/smarttutor.sqlite

# For local MySQL, replace the SQLite setting with DB_CLIENT=mysql2
# and provide the following lines using your own local account:
# DB_CLIENT=mysql2
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=smarttutor_dev
# DB_PASSWORD=choose_your_own_secret
# DB_NAME=smarttutor_dev
# DB_SSL=false
#
# Hosted TiDB: always enable verified TLS; provide DB_SSL_CA as needed.
# Never commit actual passwords, tokens, host-specific secrets, or CA keys.
