# Frontend variables are public. Never put credentials in VITE_* values.
# Mock is the default while backend PR #2 is awaiting integration.
VITE_API_MODE=mock
# Live mode requests <base URL>/health. Use /api with the local Vite proxy.
VITE_API_BASE_URL=/api
# Development-only proxy to the separate backend service.
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
